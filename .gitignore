# ============================================================
#  .gitignore — Projet Tsenan'tsika
# ============================================================

# --- Python / Backend ---
venv/
.venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/

# Variables d'environnement (contient le mot de passe de la base !)
.env
*.env

# --- Node / Frontend & Mobile ---
node_modules/
dist/
build/
.expo/
.expo-shared/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Éditeurs / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# --- Fichiers temporaires / sortie ---
*.tmp
*.bak
coverage/
.coverage
htmlcov/